.recipe-card {
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  width: 450px;
  height: 300px;
  margin: 0.5rem;
  padding: 5px;
  text-align: center;
  border: 16px double rgb(226, 218, 101);
  border-radius: 20px;
  color: black;
  position: relative;

  h4 {
    color: rgb(243, 53, 180);
    text-shadow: 1px 1px 2px rgb(65, 1, 43);
    border-image-slice: 34% fill;
    border-image-width: 2rem;
    border-image-outset: 1rem;
    border-image-repeat: round;
    border-image-source: url(<%= asset_path "star-border.png"%>);
  }

  p {
  color: rgb(46, 34, 54);
  text-shadow: 1px 1px 8px rgb(235, 193, 255);
  font-weight: 600;
  }

  .background-blur {
    img {
      position: absolute;
      width: 100%;
      height: 100%;
      top: 0;
      left: 0;
      z-index: -1;
      border-radius: 20px;
      object-fit: cover;
      object-position: center;
      filter: blur(5px);
      opacity: 0.75;
    }
  }
}
