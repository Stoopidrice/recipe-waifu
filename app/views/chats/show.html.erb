<h3><%= link_to "Home", root_path %></h3>
<div class="chat-title d-flex justify-content-center mb-3">
  <h1><%= @chat.title %></h1>
</div>
<div class="container chat-page">
  <%= render "messages/messages", messages: @chat.messages %>
  <div class="row g-4 justify-content-center">
    <% 3.times do %>
      <div class="col-12 col-md-6 col-lg-4">
        <%= link_to "#", class: "text-decoration-none text-dark" do %>
          <div class="card chat-recipe-card rounded-4 overflow-hidden shadow-sm">
            <%= image_tag "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6d/Good_Food_Display_-_NCI_Visuals_Online.jpg/1920px-Good_Food_Display_-_NCI_Visuals_Online.jpg", class: "card-img-top" %>
            <div class="card-body">
              <h3 class="card-title">Recipe Title</h3>
              <h4 class="mb-1">🍽️ Serves: 2</h4>
              <h4 class="mb-1">⏱️ 30 mins</h4>
              <h4 class="mb-3">Difficulty</h4>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
  <h1><%= @chat.title %></h1>
  <% if @chat.messages.any? %>
    <% @chat.messages.each do |message| %>
      <% if message.role == "user" %>
        <div class="d-flex justify-content-end mb-2">
          <strong class="me-2">You</strong>
          <div class="bg-white px-3 pt-3 pb-0 rounded-pill">
            <%= message.content %>
          </div>
        </div>
      <% elsif message.role == "assistant" %>
        <div class="d-flex justify-content-start mb-5">
          <strong class="me-2">Umami-chan</strong>
          <div class="px-3 pt-3 pb-0">
            <%= message.content %>
          </div>
          <div class="three-choices card d-flex align-items-center justify-content-between">
            <span class="fw-medium">
              1: <%= message.recipes[0]["title"] %>
            </span>
            <%= button_to "Run Recipe Creation Test Choice 1",
              test_create_recipes_path,
              method: :post,
              params: { message_id: message.id, recipe_index: 0 },
              class: "btn btn-danger m-3" %>
            <span class="fw-medium">
              2: <%= message.recipes[1]["title"] %>
            </span>
            <%= button_to "Run Recipe Creation Test Choice 2",
              test_create_recipes_path,
              method: :post,
              params: { message_id: message.id, recipe_index: 1 },
              class: "btn btn-danger m-3" %>
            <span class="fw-medium">
              3: <%= message.recipes[2]["title"] %>
            </span>
            <%= button_to "Run Recipe Creation Test Choice 3",
              test_create_recipes_path,
              method: :post,
              params: { message_id: message.id, recipe_index: 2 },
              class: "btn btn-danger m-3" %>
          </div>
        </div>
      <% end %>
    <% end %>
  <% end %>
</div>
<div id="new_msg_container">
  <%= render "messages/form", chat: @chat, message: @message %>
</div>
</div>
