<div class="edit-profile-container">
  <h2>Edit Your Profile</h2>

  <%= form_with model: @user, url: user_path(@user), method: :patch, local: true, class: "edit-profile-form" do |f| %>

    <% if @user.errors.any? %>
      <div class="form-errors" style="color: red; background: #fee2e2; padding: 15px; border-radius: 6px; margin-bottom: 20px;">
        <h4>Could not save changes:</h4>
        <ul>
          <% @user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :username %>
      <%= f.text_field :username, class: "form-input", placeholder: "Choose a username" %>
    </div>

    <div class="form-group">
      <%= f.label :email %>
      <%= f.email_field :email, class: "form-input", required: true %>
    </div>

    <div class="form-actions">
      <%= f.submit "Save Changes", class: "btn-save" %>
      <%= link_to "Cancel", user_path(@user), class: "btn-cancel" %>
    </div>

  <% end %>
</div>
