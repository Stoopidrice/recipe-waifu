<div class="account-container">

  <div class="profile-card">
    <div class="card-title">
      <h2><strong>Your Account Profile</strong></h2>
    </div>
    <p><strong>Username:</strong> <%= @user.username.presence || "No Username Set" %> </p>
    <p><strong>Email:</strong> <%= @user.email %> </p>
    <%= link_to "Edit Profile", edit_user_path(@user), class: "edit-profile-btn" %>
  </div>

  <div class="dietary-requirements-settings">

    <div class="card-title">
      <h2><strong>Dietary Requirements Settings</strong></h2>
    </div>

    <%# 1. Allergies Section %>
    <%= render "tag_section",
              title: "Allergies",
              placeholder: "Add allergy (e.g., peanuts)",
              type: "allergy",
              scope: :allergy,
              form_url: add_allergy_user_path(@user),
              field_name: :name,
              delete_route_method: :remove_allergy_user_path,
              items: @user.allergies %>

    <%# 2. Preferences Section %>
    <%= render "tag_section",
              title: "Preferences",
              placeholder: "Add a preference (e.g., high protein meal)",
              type: "preference",
              form_url: add_preference_user_path(@user),
              field_name: :preference_name,
              delete_route_method: :remove_preference_user_path,
              items: (@user.preferences.to_s.split(',').map(&:strip).reject(&:empty?)) %>

    <%# 3. Dislikes Section %>
    <%= render "tag_section",
              title: "Dislikes",
              placeholder: "Add a dislike (e.g., onions)",
              type: "dislike",
              form_url: add_dislike_user_path(@user),
              field_name: :dislike_name,
              delete_route_method: :remove_dislike_user_path,
              items: (@user.dislikes.to_s.split(',').map(&:strip).reject(&:empty?)) %>

  </div>

  <div class="measurement-settings">
    <div class="card-title">
      <h2><strong>Preferences</strong></h2>
    </div>
    <div class="unit-setting">
      <strong>Measurement System:</strong>

      <%= form_with model: @user, url: user_path(@user), method: :patch, local: true, class: "inline-unit-form" do |f| %>
        <%= f.select :unit_preference,
                    [["Metric (g, ml)", "metric"], ["Imperial (oz, lbs)", "imperial"]],
                    { include_blank: "Select System" },
                    { class: "unit-dropdown", onchange: "this.form.submit();" } %>
      <% end %>
    </div>
  </div>

</div>
