<h1 class="text-center">Waifood</h1>

<div class="centering">
  <div class="recipe-container">
    <p><i class="fa-solid fa-certificate"></i>Suggested!</p>
    <div class="d-flex justify-content-center">
      <% @recipes.each do |recipe| %>
        <%= link_to recipe_path(recipe) do %>
          <div class="recipe-card">
            <h4><%= recipe.title %></h4>
            <p><%= recipe.description %></p>
            <div class="d-flex justify-content-around">
              <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
              <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
