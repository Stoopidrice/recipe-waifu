<h1 class="text-center">Waifood</h1>

<% if user_signed_in? %>
  <div class="d-flex justify-content-evenly">
    <h3><%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete, turbo_confirm: "Log out?" } %></h3>
    <h3><%= link_to "Settings", user_path(current_user) %></h3>
  </div>
<% else %>
  <h3><%= link_to "Sign in", new_user_session_path %></h3>
<% end %>
<%# I have the above set up for now. Will likely be replaced by a proper nav-bar. %>

<div class="centering">
  <div class="recipe-container">
    <p><i class="fa-solid fa-certificate"></i>Suggested!</p>
    <div class="d-flex justify-content-center">
      <% @recipes.each do |recipe| %>
        <%= link_to recipe_path(recipe) do %>
          <div class="recipe-card">
            <div class="background-blur">
              <%= image_tag "anime-kitchen.jpg" %>
            </div>
            <h4 style="font-family: $headers-font;"><%= recipe.title %></h4>
            <p style="font-family: $body-font;"><%= recipe.description %></p>
            <div class="d-flex justify-content-around">
              <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
              <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<% if user_signed_in? %>
  <div class="centering">
    <div class="recipe-container">
      <p><i class="fa-solid fa-utensils"></i>Your Recipes!</p>
      <div class="d-flex justify-content-center">
        <% if current_user.recipes != [] %>
          <% current_user.recipes.each do |recipe| %>
            <%= link_to recipe_path(recipe) do %>
              <div class="recipe-card">
                <div class="background-blur">
                  <%= image_tag "cooking-stove.jpg" %>
                </div>
                <h4><%= recipe.title %></h4>
                <p><%= recipe.description %></p>
                <div class="d-flex justify-content-around">
                  <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
                  <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
        <div class="recipe-card">
          <i class="fa-solid fa-utensils"></i>
          <p>Nothing here yet!</p>
          <%# Can add a link to the ai recipe creator here %>
          <i class="fa-solid fa-utensils"></i>
        </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>

<div class="centering">
  <%= link_to new_chat_path, class: "ask_recipe_button" do %>
    <p>Ask for a recipe</p>
    <%= image_tag "cooking-pot.png" %>
  <% end %>
</div>
