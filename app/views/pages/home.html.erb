<div class="d-flex justify-content-center mt-4">
  <%= image_tag "recommended.png", class: "recommended-your-recipes-hp" %>
</div>
<div class="d-flex justify-content-center">
</div>
<div class="centering">
  <div class="recipe-container">
    <div class="card-group-container">
      <% @recipes.each do |recipe| %>
        <%= link_to recipe_path(recipe) do %>
          <div class="recipe-card">
            <div class="background-blur">
              <%= image_tag "anime-kitchen.jpg" %>
            </div>
            <h4><%= recipe.title %></h4>
            <p style="font-family: $playful-font;"><%= recipe.description %></p>
            <div class="d-flex justify-content-around">
              <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
              <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
            </div>
          </div>
        <% end %>
      <% end %>
      <% @recipes.each do |recipe| %>
        <%= link_to recipe_path(recipe) do %>
          <div class="recipe-card">
            <div class="background-blur">
              <%= image_tag "anime-kitchen.jpg" %>
            </div>
            <h4 style="font-family: $bubbly-font;"><%= recipe.title %></h4>
            <p style="font-family: $body-font;"><%= recipe.description %></p>
            <div class="d-flex justify-content-around">
              <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
              <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
<% if user_signed_in? %>
  <div class="d-flex justify-content-center mt-4">
    <%= image_tag "your-recipes.png", class: "recommended-your-recipes-hp" %>
  </div>
  <div class="d-flex justify-content-center mt-1">
  </div>
  <div class="centering">
    <div class="recipe-container pt-4 mt-2">
      <div class="d-flex flex-wrap justify-content-center">
        <% if current_user.recipes != [] %>
          <% current_user.recipes.each do |recipe| %>
            <%= link_to recipe_path(recipe) do %>
              <div class="recipe-card">
                <div class="background-blur">
                  <%= image_tag "cooking-stove.jpg" %>
                </div>
                <h4><%= recipe.title %></h4>
                <p><%= recipe.description %></p>
                <div class="d-flex justify-content-around">
                  <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
                  <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
                </div>
              </div>
            <% end %>
          <% end %>
        <% else %>
          <div class="recipe-card">
            <i class="fa-solid fa-utensils"></i>
            <p>Nothing here yet!</p>
            <%# Can add a link to the ai recipe creator here %>
            <i class="fa-solid fa-utensils"></i>
          </div>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
<div class="d-flex justify-content-center my-5">
  <%= link_to new_chat_path, class: "ask_recipe_button" do %>
    <p>Ask for a recipe</p>
    <%= image_tag "cooking-pot.png" %>
  <% end %>
</div>
