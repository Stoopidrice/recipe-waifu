<h1 class="text-center">Waifood</h1>

<% if user_signed_in? %>
  <h3><%= link_to "Log out", destroy_user_session_path, data: { turbo_method: :delete, turbo_confirm: "Log out?" } %></h3>
<% else %>
  <h3><%= link_to "Sign in", new_user_session_path %></h3>
<% end %>

<div class="centering">
  <div class="recipe-container">
    <p><i class="fa-solid fa-certificate"></i>Suggested!</p>
    <div class="d-flex justify-content-center">
      <% @recipes.each do |recipe| %>
        <%= link_to recipe_path(recipe) do %>
          <div class="recipe-card">
            <h4><%= recipe.title %></h4>
            <p><%= recipe.description %></p>
            <div class="d-flex justify-content-around">
              <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
              <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
            </div>
          </div>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<% if user_signed_in? %>
  <div class="centering">
    <div class="recipe-container">
      <p><i class="fa-solid fa-utensils"></i>Your Recipes!</p>
      <div class="d-flex justify-content-center">
        <% if current_user.recipes != nil %>
          <% current_user.recipes.each do |recipe| %>
            <%= link_to recipe_path(recipe) do %>
              <div class="recipe-card">
                <h4><%= recipe.title %></h4>
                <p><%= recipe.description %></p>
                <div class="d-flex justify-content-around">
                  <p><i class="fa-solid fa-kitchen-set">---</i><%= recipe.difficulty %>/10</p>
                  <p><i class="fa-solid fa-star"></i>---<%= recipe.rating %>/5</p>
                </div>
              </div>
            <% end %>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
<% end %>
