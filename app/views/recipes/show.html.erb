<div class="banner py-5" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url('<%= asset_path(@banner) %>'); min-height: 450px; background-size: cover; background-position: center;"">
  <div class="container d-flex flex-column align-items-center justify-content-center h-100 py-5 text-white text-center">
    <h1><%= @recipe.title %></h1>
    <h2><%= @recipe.description %></h2>
  </div>
</div>

<div class="recipe-card card-trip rounded-3 p-4 bg-light shadow-sm">
  <div class="row w-100 g-4">

    <div class="col-12 col-md-6 d-flex flex-column justify-content-center border-end-md">
      <div class="mb-3 d-flex justify-content-between align-items-center pb-2 border-bottom">
        <span class="text-muted fw-bold text-uppercase small">Difficulty</span>
        <span class="badge bg-secondary fs-6"><%= @recipe.difficulty %></span>
      </div>
      <div class="mb-3 d-flex justify-content-between align-items-center pb-2 border-bottom">
        <span class="text-muted fw-bold text-uppercase small">Taste Rating</span>
        <span class="fw-bold text-warning fs-5">★ <%= @recipe.rating %>/5</span>
      </div>
      <div class="mb-3 d-flex justify-content-between align-items-center pb-2 border-bottom">
        <span class="text-muted fw-bold text-uppercase small">Servings</span>
        <span class="fw-semibold text-dark fs-5"><%= @recipe.servings %> people</span>
      </div>
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted fw-bold text-uppercase small">Calories</span>
        <span class="fw-bold text-danger fs-5"><%= @recipe.calories %> kcal</span>
      </div>
    </div>


    <div class="col-12 col-md-6 d-flex flex-column justify-content-center card-trip-infos">
      <div class="mb-4 text-center p-3 bg-white rounded-3 border">
        <span class="text-muted d-block text-uppercase small fw-bold mb-1">Prep Time</span>
        <span class="display-6 fw-bold text-primary"><%= @recipe.prep_time %></span>
        <span class="text-muted">mins</span>
      </div>
      <div class="text-center p-3 bg-white rounded-3 border">
        <span class="text-muted d-block text-uppercase small fw-bold mb-1">Cooking Time</span>
        <span class="display-6 fw-bold text-success"><%= @recipe.cook_time %></span>
        <span class="text-muted">mins</span>
      </div>
    </div>

  </div>
</div>

  <div class="recipe-instructions-text text-secondary lh-base fs-5 d-flex flex-wrap gap-3 justify-content-center align-items-center m-4 mx-auto" style="max-width: 800px;">
    <!-- Rails helper that automatically keeps your line breaks and spacing intact -->
    <%= simple_format(@recipe.instructions) %>
  </div>
</div>
