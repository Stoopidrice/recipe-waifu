<div class="banner py-5" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url('<%= asset_path(@banner) %>'); min-height: 450px; background-size: cover; background-position: center;">
  <div class="container d-flex flex-column align-items-center justify-content-center h-100 py-5 text-white text-center">
    <h1><%= @recipe.title %></h1>
    <h2><%= @recipe.description %></h2>
  </div>
</div>

<div class="recipe-overview-card card-trip">
  <div class="row w-100 g-4">

    <div class="col-12 col-md-6 d-flex flex-column justify-content-center border-end-md">
      <div class="mb-3 d-flex justify-content-between align-items-center pb-2 border-bottom">
        <span class="text-muted fw-bold text-uppercase fs-4">Difficulty</span>
        <span class="difficulty-number"><%= @recipe.difficulty %>/10</span>
      </div>
      <div class="mb-3 d-flex justify-content-between align-items-center pb-2 border-bottom">
        <span class="text-muted fw-bold text-uppercase fs-4">Taste Rating</span>
        <span class="rating-stars fw-bold text-warning fs-5"> <%= (image_tag "star.png") * @recipe.rating %></span>
      </div>
      <div class="mb-3 d-flex justify-content-between align-items-center pb-2 border-bottom">
        <span class="text-muted fw-bold text-uppercase fs-4">Servings</span>
        <span class="fw-semibold text-dark fs-4"><%= @recipe.servings %> people</span>
      </div>
      <div class="d-flex justify-content-between align-items-center">
        <span class="text-muted fw-bold text-uppercase fs-4">Calories</span>
        <span class="fw-bold fs-4"><%= @recipe.calories %> kcal</span>
      </div>
    </div>


    <div class="col-12 col-md-6 d-flex flex-column justify-content-center card-trip-infos">
      <div class="the-times mb-4 text-center p-3 rounded-3">
        <%= image_tag "anime-kitchen.jpg" %>
        <span class="text-muted d-block text-uppercase small fw-bold mb-1">Prep Time</span>
        <span id="prep-time"><%= @recipe.prep_time %></span>
        <span class="text-muted fs-4">mins</span>
      </div>
      <div class="the-times text-center p-3 rounded-3">
        <%= image_tag "cooking-stove.jpg" %>
        <span class="text-muted d-block text-uppercase small fw-bold mb-1">Cooking Time</span>
        <span id="cooking-time"><%= @recipe.cook_time %></span>
        <span class="text-muted fs-4">mins</span>
      </div>

    </div>

  </div>
</div>
<div class="row g-4 mt-2">
  <div class="col-12 col-md-4">
    <div id="ingredients-box" class="border-0 rounded-3 mt-1 p-4 h-100">
      <span class="text-muted d-block text-uppercase fs-5 fw-bold mb-1">Ingredients</span>
        <ul>
        <span class="d-block text-uppercase fs-6 fw-bold mb-1">
          <% if @recipe.ingredients.present? %>
          <% @recipe.ingredients.split(',').each do |ingredient| %>
          <li>
            <%= ingredient %>
            </li>
            <% end %>
            <% end %>
          </span>
        </ul>
      </div>
      </div>
  <div class="recipe-instructions col-12 col-md-8">
  <div class="lh-base fs-5 d-flex flex-wrap gap-3 justify-content-center align-items-center p-2 m-4 mx-auto" style="max-width: 800px;">
    <%= simple_format(@recipe.instructions) %>
  </div>
</div>
<div class="home-btn d-flex justify-content-center">
<%= link_to root_path, class:"recipe-button" do %>
  <%= image_tag "home.png" %>
<% end %>

<% if @recipe.chat_id.present? %>
  <%= link_to chat_path(@target_chat, edit_recipe_id: @recipe.id), class: "recipe-button" do %>
    <%= image_tag "edit.png" %>
  <% end %>
<% else %>
  <%= button_to chats_path(chat: { title: @target_chat.title }), method: :post, class: "recipe-button" do %>
    <%= image_tag "edit.png" %>
  <% end %>
<% end %>

<%= button_to add_recipe_user_path(current_user), method: :post, params: { recipe_id: @recipe.id }, class: "recipe-button" do %>
  <%= image_tag "add.png" %>
<% end %>

<% unless current_user.recipes.find_by( id: @recipe.id).nil? %>
  <%= button_to remove_recipe_user_path(current_user),
      method: :delete,
      params: { recipe_id: @recipe.id },
      class: "recipe-button",
      data: { turbo_confirm: "Are you sure? (Don't get the wrong idea... It's not like I'll miss it or anything!)" } do %>
    <%= image_tag "delete.png" %>
  <% end %>
<% end %>
</div>
<div class="banner py-5" style="background-image: linear-gradient(rgba(0,0,0,0.4),rgba(0,0,0,0.4)), url('<%= image_path("umami-jesus.png") %>'); min-height: 450px; background-size: cover; background-position: 0px 40%;">
</div>
</div>
