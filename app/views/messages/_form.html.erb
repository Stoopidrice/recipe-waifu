   <%= simple_form_for [chat, message] do |f| %>
  <div class="chat-input-container row justify-content-center">
    <div class="col-12 col-md-8">
      <%= f.input :content,
        label: " ",
        required: true,
        placeholder: "Ask Umami-chan something...",
        input_html: { class: "cloud-input" }  %>
    </div>
    <div class="col-auto d-flex align-items-center">
      <%= f.button :submit, "Send",
        class: "btn btn-primary" %>
    </div>
  </div>
<% end %>
