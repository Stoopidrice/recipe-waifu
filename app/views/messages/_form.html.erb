<% if params[:edit_recipe_id].present? %>
  <% editing_recipe = Recipe.find_by(id: params[:edit_recipe_id]) %>

  <% if editing_recipe %>
    <div class="p-2 px-3 bg-warning-subtle text-warning-dark border-bottom d-flex justify-content-between align-items-center small">
      <span>Editing: <strong><%= editing_recipe.title %></strong></span>
      <%= link_to "✕ Cancel", chat_path(@chat), class: "text-decoration-none text-muted font-monospace fw-bold" %>
    </div>
  <% end %>
<% end %>

  <%= simple_form_for [chat, message], html: { id: "new_message_form", data: { turbo_stream: true } } do |f| %>
    <%= hidden_field_tag :edit_recipe_id, params[:edit_recipe_id] if params[:edit_recipe_id].present? %>
    <div class="chat-input-container row justify-content-center">
      <div class="col-12 col-md-8">
        <%= f.input :content,
          label: " ",
          required: true,
          placeholder: "Ask Umami-chan something...",
          input_html: { class: "cloud-input", value: (message.new_record? ? "" : message.content) }  %>
      </div>
      <div class="col-auto d-flex align-items-center ">
    <div class="d-flex justify-content-center my-5 ">
  <%= button_tag type: "submit", class: "ask_recipe_button" do %>
    <p class=>Send</p>
    <%= image_tag "cooking-pot.png" %>
  <% end %>
      </div>
    </div>
  <% end %>
