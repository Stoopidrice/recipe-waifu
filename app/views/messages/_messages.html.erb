<% if @chat.messages.any? %>
  <% messages.each do |message| %>
    <% if message.role == "user" %>
      <div class="d-flex justify-content-end mb-2">
        <div class="user-message">
          <strong class="me-2">You</strong>
          <div class="px-3 pt-3 pb-0 rounded-pill">
            <%= message.content %>
          </div>
        </div>
      </div>
    <% elsif message.role == "assistant" %>
      <div class="d-flex justify-content-start mb-5">
        <div class="umami-message-name w-100">
          <%= image_tag "umami-judgmental.png", class: "umami-avatar" %>
          <strong class="me-2">Umami-chan</strong>
          <div class="assistant-bubble">
            <%= message.content %>

            <%# Display recipes right under the text, inside the chat bubble bounds or immediately aligned beneath it %>
            <% if message.recipes.present? %>
              <div class="row g-3 justify-content-start mt-3">
                <% message.recipes.compact.each do |recipe| %>
                  <div class="col-12 col-md-6 col-lg-4">
                    <%= link_to "#", class: "text-decoration-none text-dark" do %>
                      <div class="card chat-recipe-card rounded-4 overflow-hidden shadow-sm h-100 bg-white text-start">
                        <%= image_tag "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6d/Good_Food_Display_-_NCI_Visuals_Online.jpg/1920px-Good_Food_Display_-_NCI_Visuals_Online.jpg", class: "card-img-top" %>
                        <div class="card-body p-3">
                          <h3 class="card-title"><%= recipe["title"] %></h3>
                          <h3 class="card-desc"><%= recipe["description"] %></h3>
                          <h4 class="mb-1">🍽️ <%= recipe["servings"] %></h4>
                          <h4 class="mb-1">⏱️ <%= recipe["cook_time"] %></h4>
                          <h4 class="mb-3">📊 <%= recipe["difficulty"] %></h4>
                        </div>
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>

          </div>
        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p>No chat history. Hurry up and say something!</p>
<% end %>
