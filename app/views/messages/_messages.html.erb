  <% if @chat.messages.any? %>
  <% umami_count = 0 %>
  <% @chat.messages.each do |message| %>
    <% if message.role == "user" %>
      <div class="d-flex justify-content-end mb-2">
        <div class="user-message">
          <strong class="me-2">You</strong>
          <div class="px-3 pt-3 pb-0 rounded-pill">
            <%= message.content %>
          </div>
        </div>
      </div>
    <% elsif message.role == "assistant" %>
      <% umami_image = case umami_count
    when 0
      "umami-judgmental.png"
    when 1
      "umami-extra-angry.png"
    else
      "umami-overwhelmed.png"
    end
    %>
      <div class="d-flex justify-content-start mb-5">
        <div class="umami-message-name">
          <%= image_tag umami_image, class: "umami-avatar" %>
          <strong class="me-2">Umami-chan</strong>
          <div class="assistant-bubble">
            <%= message.content %>
          </div>
          <% umami_count += 1 %>
          <%# <div class="container chat-page"> %>
            <div class="row g-4 justify-content-center">
              <% 3.times do |i| %>
                <div class="col-12 col-md-6 col-lg-4">
                  <% is_editing = params[:edit_recipe_id].present? %>
                  <% target_path = is_editing ? update_recipe_recipe_path(id: params[:edit_recipe_id]) : test_create_recipes_path %>
                  <% the_HTTP_method  = is_editing ? :patch : :post %>

                  <% button_params = { message_id: message.id, recipe_index: i } %>
                  <% button_params[:recipe_id] = params[:edit_recipe_id] if is_editing %>

                  <%= button_to target_path,
                            method: the_HTTP_method,
                            params: button_params,
                            class: "bg-transparent text-decoration-none text-dark border-0 w-100" do %>

                  <%= render "messages/recipe_card", message: message, i: i, is_editing: is_editing %>

                    <% end %>
                </div>
              <% end %>
            </div>
          </div>




        </div>
      <%# </div> %>
    <% end %>
  <% end %>
<% else %>
  <div class ="no-chats-container">
    <%= image_tag "umami-overwhelmed.png", class: "no-chats-image" %>
    <p class ="no-chats-text">Stop wasting my time. Hurry up and say something!</p>
  </div>
<% end %>

