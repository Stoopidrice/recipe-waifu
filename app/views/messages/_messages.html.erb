  <% if @chat.messages.any? %>
  <% messages.each do |message| %>
    <% if message.role == "user" %>
      <div class="d-flex justify-content-end mb-2">
        <div class="user-message">
          <strong class="me-2">You</strong>
          <div class="px-3 pt-3 pb-0 rounded-pill">
            <%= message.content %>
          </div>
        </div>
      </div>
    <% elsif message.role == "assistant" %>
      <div class="d-flex justify-content-start mb-5">
        <div class="umami-message-name">
          <%= image_tag "umami-judgmental.png", class: "umami-avatar" %>
          <strong class="me-2">Umami-chan</strong>
          <div class="assistant-bubble">
            <%= message.content %>
          </div>
          <div class="container chat-page">
  <div class="row g-4 justify-content-center">
      <div class="col-12 col-md-6 col-lg-4">
    <% 3.times do |i| %>
    <%= button_to test_create_recipes_path,
              method: :post,
              params: { message_id: message.id, recipe_index: i },
              class: "bg-transparent text-decoration-none text-dark border-0" do %>
          <div class="card chat-recipe-card rounded-4 overflow-hidden shadow-sm">
            <%= image_tag "https://upload.wikimedia.org/wikipedia/commons/thumb/6/6d/Good_Food_Display_-_NCI_Visuals_Online.jpg/1920px-Good_Food_Display_-_NCI_Visuals_Online.jpg", class: "card-img-top" %>
            <div class="card-body">
              <h3 class="card-title"><%= message.recipes[i]["title"] %></h3>
              <h3 class="card-desc"><%= message.recipes[i]["description"] %></h3>
              <h4 class="mb-1">🍽️ Serves: <%= message.recipes[i]["servings"]%></h4>
              <h4 class="mb-1">⏱️: <%=message.recipes[i]["cook_time"] %></h4>
              <h4 class="mb-3">Difficulty: <%=message.recipes[i]["difficulty"] %></h4>
            </div>
          </div>
        <% end %>
      <% end %>
      </div>
  </div>
</div>

        </div>
      </div>
    <% end %>
  <% end %>
<% else %>
  <p>No chat history. Hurry up and say something!</p>
<% end %>
