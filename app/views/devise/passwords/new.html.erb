<h3><%= link_to "Home", root_path %></h3>
<%# I have the above set up for now. Will likely be replaced by a proper nav-bar. %>

<div class="centering">
  <div class="authentication-form-container">
    <h2 class="text-center">Forgot your password?</h2>

    <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= f.error_notification %>

      <div class="form-inputs">
        <%= f.input :email,
                    required: true,
                    autofocus: true,
                    input_html: { autocomplete: "email" } %>
      </div>

      <div class="form-actions">
        <%= f.button :submit, "Send me password reset instructions", input_html: { class: "text-center" } %>
      </div>
    <% end %>
    <div class="d-flex justify-content-evenly" style="translate: 0 160px;">
      <%= render "devise/shared/links" %>
    </div>
  </div>
</div>
